APP_ENV=development
DATABASE_URL=postgresql+psycopg2://widget:widget@db:5432/widgetforge
JWT_SECRET=replace-this-before-any-non-demo-use
JWT_EXPIRE_MINUTES=60
PUBLIC_BASE_URL=http://localhost:8000
# Widget origins are configured per widget in the dashboard, not in this file.
MAX_SUBMISSION_BYTES=16384
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
IP_HASH_SECRET=replace-this-too
NOTIFIER_MODE=console
# Set NOTIFIER_MODE=webhook only after providing a receiver and a long random secret.
WEBHOOK_URL=
WEBHOOK_SECRET=
# During secret rotation, temporarily set the previous secret as well; remove it after receivers accept the new one.
WEBHOOK_PREVIOUS_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5
GEO_ENRICHMENT_ENABLED=false
GEO_REQUEST_TIMEOUT_SECONDS=1.5
OUTBOX_POLL_SECONDS=2
